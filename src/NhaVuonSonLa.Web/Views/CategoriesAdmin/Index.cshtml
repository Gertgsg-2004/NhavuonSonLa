@model List<Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_AdminLayout";
}

<div class="admin-cols">
    <div class="admin-panel">
        <div class="admin-panel-head"><h2>@Model.Count danh mục</h2></div>
        <table class="table">
            <thead><tr><th>Tên</th><th>Đường dẫn</th><th>Thứ tự</th><th>SP</th><th></th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <form method="post" action="/quan-tri/danh-muc/luu" style="display:flex;gap:6px;align-items:center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <input class="field" style="margin:0;width:160px" name="name" value="@c.Name" />
                                <input class="field" style="margin:0;width:64px" name="sortOrder" type="number" value="@c.SortOrder" />
                                <button type="submit" class="link-action">Lưu</button>
                            </form>
                        </td>
                        <td class="muted">@c.Slug</td>
                        <td>@c.SortOrder</td>
                        <td>@c.Products.Count</td>
                        <td>
                            <form method="post" action="/quan-tri/danh-muc/xoa/@c.Id" style="display:inline"
                                  onsubmit="return confirm('Xóa danh mục &quot;@c.Name&quot;?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="link-action danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="admin-panel" style="height:fit-content">
        <div class="admin-panel-head"><h2>Thêm danh mục</h2></div>
        <form method="post" action="/quan-tri/danh-muc/luu">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="0" />
            <label>Tên danh mục</label>
            <input class="field" name="name" placeholder="vd: Bưởi" required />
            <label>Thứ tự hiển thị</label>
            <input class="field" name="sortOrder" type="number" value="@Model.Count" />
            <button type="submit" class="btn btn-primary btn-block">+ Thêm danh mục</button>
        </form>
    </div>
</div>

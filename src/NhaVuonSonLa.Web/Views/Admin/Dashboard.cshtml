@model DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
    Layout = "_AdminLayout";
    var maxCount = Model.QuotesByProduct.Any() ? Model.QuotesByProduct.Max(x => x.Count) : 1;
}

<div class="stat-grid">
    <div class="stat-card"><div class="stat-num">@Model.ProductCount</div><div class="stat-label">Sản phẩm</div><div class="stat-sub">@Model.ActiveProductCount đang bán</div></div>
    <div class="stat-card"><div class="stat-num">@Model.CategoryCount</div><div class="stat-label">Danh mục</div></div>
    <div class="stat-card"><div class="stat-num">@Model.InSeasonCount</div><div class="stat-label">Đang vào mùa</div></div>
    <div class="stat-card accent"><div class="stat-num">@Model.QuoteCount</div><div class="stat-label">Yêu cầu báo giá</div><div class="stat-sub">@Model.PendingQuoteCount chờ xử lý</div></div>
</div>

<div class="admin-cols">
    <section class="admin-panel">
        <div class="admin-panel-head"><h2>Báo giá gần đây</h2><a href="/quan-tri/bao-gia">Xem tất cả →</a></div>
        @if (Model.RecentQuotes.Any())
        {
            <table class="table">
                <thead><tr><th>Mã</th><th>Khách hàng</th><th>SP</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var q in Model.RecentQuotes)
                    {
                        <tr>
                            <td><b>@q.Code</b></td>
                            <td>@q.FullName<div class="muted" style="font-size:12px">@q.Phone</div></td>
                            <td>@q.Items.Count</td>
                            <td><span class="tag">@q.Status</span></td>
                            <td><a href="/quan-tri/bao-gia/@q.Id">Chi tiết</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="muted">Chưa có yêu cầu báo giá nào.</p>
        }
    </section>

    <section class="admin-panel">
        <div class="admin-panel-head"><h2>Sản phẩm được hỏi nhiều</h2></div>
        @if (Model.QuotesByProduct.Any())
        {
            @foreach (var (name, count) in Model.QuotesByProduct)
            {
                <div class="bar-row">
                    <div class="bar-label">@name</div>
                    <div class="bar-track"><div class="bar-fill" style="width:@(count * 100 / maxCount)%"></div></div>
                    <div class="bar-val">@count</div>
                </div>
            }
        }
        else
        {
            <p class="muted">Chưa có dữ liệu — khi khách gửi báo giá sẽ thống kê ở đây.</p>
        }
    </section>
</div>

@model ProductListViewModel
@{
    ViewData["Title"] = "Sản phẩm — Trái cây sỉ theo mùa vụ";
    var certs = new[] { "VietGAP", "GlobalGAP", "Organic" };
}

<div class="container" style="padding-top:32px">
    <div class="crumbs"><a asp-controller="Home" asp-action="Index">Trang chủ</a> / <span>Sản phẩm</span></div>
    <h1 style="margin:0">Sản phẩm sỉ theo mùa vụ</h1>
    <p class="muted" style="max-width:680px">Giá hiển thị là giá sỉ tham khảo theo bậc số lượng. Sản phẩm cao cấp báo giá theo thời điểm — bấm "Thêm vào báo giá" để gửi yêu cầu.</p>

    <div class="with-sidebar" style="margin-top:24px">
        <aside>
            <div class="filter-group">
                <h3>Mùa vụ</h3>
                <a class="filter-link @(Model.InSeasonOnly ? "active" : "")"
                   asp-action="Index" asp-route-season="@(Model.InSeasonOnly ? null : "true")"
                   asp-route-category="@Model.Category" asp-route-region="@Model.Region" asp-route-cert="@Model.Certification" asp-route-export="@Model.ExportOnly">🌿 Đang vào mùa</a>
            </div>

            <div class="filter-group">
                <h3>Danh mục</h3>
                <a class="filter-link @(Model.Category == null ? "active" : "")" asp-action="Index">Tất cả</a>
                @foreach (var c in Model.Categories)
                {
                    <a class="filter-link @(Model.Category == c.Slug ? "active" : "")"
                       asp-action="Index" asp-route-category="@c.Slug"
                       asp-route-region="@Model.Region" asp-route-cert="@Model.Certification" asp-route-export="@Model.ExportOnly" asp-route-season="@(Model.InSeasonOnly ? "true" : null)">@c.Name</a>
                }
            </div>

            <div class="filter-group">
                <h3>Vùng trồng</h3>
                @foreach (var r in Model.Regions)
                {
                    <a class="filter-link @(Model.Region == r ? "active" : "")"
                       asp-action="Index" asp-route-region="@(Model.Region == r ? null : r)"
                       asp-route-category="@Model.Category" asp-route-cert="@Model.Certification" asp-route-export="@Model.ExportOnly" asp-route-season="@(Model.InSeasonOnly ? "true" : null)">@r</a>
                }
            </div>

            <div class="filter-group">
                <h3>Tiêu chuẩn</h3>
                @foreach (var cert in certs)
                {
                    <a class="filter-link @(Model.Certification == cert ? "active" : "")"
                       asp-action="Index" asp-route-cert="@(Model.Certification == cert ? null : cert)"
                       asp-route-category="@Model.Category" asp-route-region="@Model.Region" asp-route-export="@Model.ExportOnly" asp-route-season="@(Model.InSeasonOnly ? "true" : null)">✓ @cert</a>
                }
                <a class="filter-link @(Model.ExportOnly == true ? "active" : "")"
                   asp-action="Index" asp-route-export="@(Model.ExportOnly == true ? null : "true")"
                   asp-route-category="@Model.Category" asp-route-region="@Model.Region" asp-route-cert="@Model.Certification" asp-route-season="@(Model.InSeasonOnly ? "true" : null)">🚢 Đạt chuẩn xuất khẩu</a>
            </div>
        </aside>

        <div>
            <p class="muted" style="font-size:14px">@Model.Products.Count sản phẩm</p>
            @if (Model.Products.Any())
            {
                <div class="grid grid-3">
                    @foreach (var p in Model.Products)
                    {
                        <partial name="_ProductCard" model="p" />
                    }
                </div>
            }
            else
            {
                <div class="empty-box">Không có sản phẩm khớp bộ lọc. <a class="filter-link" style="display:inline;color:var(--green-dark)" asp-action="Index">Xóa bộ lọc</a></div>
            }
        </div>
    </div>
</div>
<div style="height:40px"></div>
